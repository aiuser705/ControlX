# Supabase Environment Variables (Client & Server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Cashfree Payments Configuration
CASHFREE_APP_ID=your_cashfree_app_id_here
CASHFREE_SECRET_KEY=your_cashfree_secret_key_here
CASHFREE_BASE_URL=https://sandbox.cashfree.com/pg
NEXT_PUBLIC_CASHFREE_ENV=TEST

# Telegram Push Notifications
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_1,your_telegram_chat_id_2

# Nodemailer / Gmail SMTP Configuration
EMAIL_USER=your_email@gmail.com
EMAIL_APP_PASSWORD=your_gmail_app_password_here

# Resend Email Configuration (Optional fallback)
RESEND_API_KEY=re_your_resend_api_key_here
